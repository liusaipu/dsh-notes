{
  "name": "dsh-quicknotes",
  "version": "1.3.1",
  "description": "A flomo-style quick-capture page in the DSH Desktop sidebar with Markdown, image attachments, and email-folder sync.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "quicknotes",
    "flomo",
    "notes",
    "memo",
    "email-sync",
    "imap"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "about": {
      "updatedAt": "2026-11-11"
    }
  },
  "author": "liusaipu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liusaipu/dsh-quicknotes.git"
  },
  "homepage": "https://github.com/liusaipu/dsh-quicknotes#readme",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
